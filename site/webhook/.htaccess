# ------------------------------------------------------------------
# Webhook Stripe — accessible SANS mot de passe.
#
# Stripe ne peut pas s'authentifier en HTTP Basic. La securite de ce
# point d'entree repose sur la verification de la signature HMAC dans
# stripe.php, pas sur l'authentification.
#
# Ce fichier annule la protection heritee du dossier parent, qui ne
# concerne que l'espace de developpement.
# ------------------------------------------------------------------

AuthType None
Require all granted

# Pas de reecriture ici : Stripe appelle l'URL exacte.
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

Options -Indexes
